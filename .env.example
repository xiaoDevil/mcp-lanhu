# 蓝湖 Cookie（必需）
# 从浏览器开发者工具中获取
LANHU_COOKIE=your_lanhu_cookie_here

# DDS Cookie（可选，默认使用 LANHU_COOKIE）
DDS_COOKIE=

# 数据存储目录
DATA_DIR=./data

# HTTP 请求超时时间（秒）
HTTP_TIMEOUT=30

# 浏览器视口宽度
VIEWPORT_WIDTH=1920

# 浏览器视口高度
VIEWPORT_HEIGHT=1080

# 调试模式
DEBUG=false

# 图片处理模式（仅在 mode=full 时生效）
# auto = 由工具调用时的 image_mode 参数决定（默认）
# direct = 直接内联 base64 图片，适合多模态模型（Claude、GPT-4o）
# mcp_assisted = 返回截图文件路径 + MCP 调用指令，适合非多模态模型 + 外部图片分析工具
# text_only_images = 跳过图片，仅使用文本内容分析
IMAGE_MODE=auto

# MCP 图片分析工具名称（当 IMAGE_MODE=mcp_assisted 时使用）
# 工具需支持本地文件路径输入，例如：mcp__zai-mcp-server__analyze_image
IMAGE_MCP_TOOL=mcp__zai-mcp-server__analyze_image
